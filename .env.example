# Databento historical data replaces the deterministic demo feed when set.
DATABENTO_API_KEY=

# Private access gate. The session secret must be at least 32 characters.
# Yazan signs in with VOLTIS_ADMIN_EMAIL + VOLTIS_ADMIN_PASSWORD. In
# development these default to yazan@voltis.trade / voltis so the sign-in flow
# works with no env file; always set real values before deploying.
VOLTIS_ADMIN_EMAIL=yazan@voltis.trade
VOLTIS_ADMIN_PASSWORD=
VOLTIS_ACCESS_PASSWORD=
VOLTIS_SESSION_SECRET=
VOLTIS_USER_ID=yazan

# Optional live gateway. Use wss:// in production and share the same secret
# with services/market-gateway.
MARKET_GATEWAY_URL=
MARKET_GATEWAY_SECRET=

# Neon persistence is enabled when this value exists. Also required for:
# persistent Tradovate connections, the trades feed on /viewer, and shared fibs.
DATABASE_URL=

# Tradovate API access (from Tradovate's API Access settings). Without these,
# account connections are rejected with a clear error and orders stay in paper
# mode. TRADOVATE_ENCRYPTION_KEY (32+ chars) encrypts stored credentials; it
# falls back to VOLTIS_SESSION_SECRET when unset.
TRADOVATE_CID=
TRADOVATE_SEC=
TRADOVATE_APP_ID=Voltis
TRADOVATE_ENCRYPTION_KEY=

# The TradersPost webhook stays disabled in v1.
TRADERSPOST_WEBHOOK_URL=
TRADING_MODE=paper
